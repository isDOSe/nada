<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/widget_wordmark"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="serif"
        android:letterSpacing="0.02"
        android:textStyle="bold"
        android:maxLines="1"
        android:text="nada!"
        android:textColor="#F2EFE6"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/widget_phrase"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="5dp"
        android:fontFamily="serif"
        android:lineSpacingExtra="1dp"
        android:maxLines="2"
        android:text="Has hecho nada&#10;durante"
        android:textColor="#A6A096"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/widget_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:autoSizeMaxTextSize="32sp"
        android:autoSizeMinTextSize="18sp"
        android:autoSizeStepGranularity="1sp"
        android:autoSizeTextType="uniform"
        android:fontFamily="serif"
        android:includeFontPadding="false"
        android:maxLines="1"
        android:text="0 min"
        android:textColor="#F2EFE6"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/widget_sessions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:fontFamily="serif"
        android:maxLines="1"
        android:text="0 sesiones"
        android:textColor="#A6A096"
        android:textSize="10sp" />
</LinearLayout>
